# Copie para .env (que e gitignored) e preencha. Nenhuma chave abaixo e necessaria
# para a busca PPUBS do USPTO — ela funciona sem credencial nenhuma.

# --- USPTO Open Data Portal (ODP) + PTAB ---
# Obter em https://account.uspto.gov/api-manager — exige verificacao de identidade via ID.me.
USPTO_API_KEY=

# --- EPO OPS v3.2 (fase A2: traz BR, CN, EP e +100 jurisdicoes via INPADOC/DOCDB) ---
# Registrar app em https://developers.epo.org — free tier 4 GB/semana.
EPO_OPS_KEY=
EPO_OPS_SECRET=

# --- Lens.org (fase A3: literatura nao-patentaria) ---
# Token de avaliacao: os termos vedam uso COMERCIAL do output durante o trial.
# Sem esta variavel, o servidor lens nao sobe (falha visivel, nao silenciosa).
LENS_TOKEN=

LOG_LEVEL=INFO
